# Скопируй этот файл в .env и впиши свои значения. .env никогда не коммить в git!
TELEGRAM_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Локально через docker-compose (см. docker-compose.yml):
DATABASE_URL=postgresql://negotiationsim:negotiationsim@localhost:5432/negotiationsim

# Время ежедневного напоминания, час по UTC (17 = 20:00 по Москве)
REMINDER_HOUR_UTC=17
